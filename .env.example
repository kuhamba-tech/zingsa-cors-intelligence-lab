# Optional: override RINEX data roots (semicolon-separated). Defaults are in lib/corsApiConfig.js
# ZINGSA_CORS_DATA_ROOT=C:\path\to\Spider;C:\path\to\TEC

# ZimCORS NTRIP service (National CORS Services → Service Access panel)
VITE_ZIMCORS_NTRIP_HOST=ntrip.zingsa.org.zw
VITE_ZIMCORS_NTRIP_PORT=2101
VITE_ZIMCORS_MOUNTPOINT_PATTERN={STATION}_RTCM3
VITE_ZIMCORS_DATUM=ITRF2014 · AFREF
VITE_ZIMCORS_FORMAT=RTCM 3.2 MSM
VITE_ZIMCORS_SUPPORT_EMAIL=cors@zingsa.org.zw
VITE_ZIMCORS_SUPPORT_ORG=ZINGSA Space Science · ZNGA

# Optional: live ZimCORS receiver telemetry (server-side, station-health API)
# JSON endpoint returning { "stations": [{ "station_id": "HARA", "status": "ONLINE", ... }] }
# ZINGSA_HEALTH_TELEMETRY_URL=https://your-telemetry-service/zimcors/health
# ZINGSA_HEALTH_TELEMETRY_TIMEOUT_MS=8000

# Local dev: blend archive health with sample receiver telemetry (data/zimcors-telemetry-sample.json)
# ZINGSA_HEALTH_TELEMETRY_SAMPLE=1
# Or point at the dev mock route: ZINGSA_HEALTH_TELEMETRY_URL=http://localhost:5174/api/gnss/telemetry-sample

# Optional: NOAA APIs (Space Weather page)
# VITE_NASA_API_KEY=your_key_here

# Optional: AstronomyAPI.com (Night Sky Viewer — local ephemeris is default)
# ASTRONOMY_API_ID=
# ASTRONOMY_API_SECRET=
