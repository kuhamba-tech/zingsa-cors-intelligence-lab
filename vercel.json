{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "excludeFiles": "{data/cors-extracted/**,data/test-extract/**,server/**,node_modules/**}",
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/ntrip/status", "schedule": "0 0 * * *" }
  ],
  "routes": [
    { "src": "^/api/(.+)$", "dest": "/api/[...path]?path=$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
